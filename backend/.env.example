
APP_BASE_PATH=/gestor-colas/
# Configuración de Django
DJANGO_SECRET_KEY=password_ejemplo
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS: orígenes permitidos para el frontend local
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CSRF: orígenes confiables para el desarrollo local
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base de datos PostgreSQL local
DB_NAME=gestor_colas
DB_USER=usuario_ejemplo
DB_PASSWORD=password_ejemplo
DB_HOST=localhost
DB_PORT=5432
